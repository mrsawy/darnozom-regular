# The client needs no auth configuration: sessions are httpOnly cookies issued
# by the API on the same origin, so there is no publishable key to set.

# When `pnpm dev` proxies /api requests, point at your API server
VITE_API_PROXY_TARGET=http://localhost:8080

# Medusa backend URL and publishable key for the JS SDK client
# The publishable key is generated in the Medusa Admin dashboard under Settings → API Key Management
VITE_MEDUSA_BACKEND_URL=http://localhost:9000
VITE_MEDUSA_PUBLISHABLE_KEY=
