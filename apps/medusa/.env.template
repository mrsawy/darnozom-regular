# Medusa v2 environment configuration
# 9010, not 9000 — 9000 is usually already taken locally.
PORT=9010
MEDUSA_ADMIN_ONBOARDING_TYPE=default
MEDUSA_DATABASE_URL=postgresql://darnozom:darnozom@localhost:5434/medusa
MEDUSA_REDIS_URL=redis://localhost:6381
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=
MEDUSA_ADMIN_CORS=http://localhost:9010
MEDUSA_STORE_CORS=http://localhost:5173
AUTH_MFA_ENCRYPTION_KEY=

# Local file provider (product image uploads). Both optional locally —
# defaults to <cwd>/static and http://localhost:9010/static, which is fine
# for dev. In production these are set by deploy/deploy.sh to a directory
# outside the redeployed app dir so uploads survive deploys.
# MEDUSA_UPLOAD_DIR=
# MEDUSA_UPLOAD_BACKEND_URL=

# Better Auth bridge secret (shared with apps/api via root .env)
BETTER_AUTH_BRIDGE_SECRET=

# Payment gateways (optional — needed if testing direct Medusa payment sessions)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=
PAYMOB_WALLET_INTEGRATION_ID=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

