# Root workspace env — used by `pnpm dev:db` (docker compose) and by the API.
# Copy to `.env` for local development. The client has its own
# apps/client/.env.example for VITE_* variables.

# --- Local Postgres (deploy/db/docker-compose.yml) ---
POSTGRES_DB=darnozom
POSTGRES_USER=darnozom
POSTGRES_PASSWORD=darnozom
# If you already run Postgres natively on 5432, set this to a free port
# (e.g. 5433) and match it in DATABASE_URL below.
POSTGRES_PORT=5432

# --- API server (apps/api) ---
DATABASE_URL=postgresql://darnozom:darnozom@localhost:5432/darnozom
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# --- Optional integrations. Every one of these is optional: the API boots and
# --- serves all unrelated routes without them; only the specific feature fails.
# --- Auth (self-hosted, Better Auth) ---
# Signing key for session cookies and tokens. REQUIRED in production — the API
# refuses to boot without it. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Comma-separated emails granted the `admin` role. Bootstrap only: listed
# addresses are promoted when they sign up (and on boot if they already have an
# account). Removing an address here does NOT demote anyone — revoke from the
# admin panel instead.
ADMIN_EMAILS=

# Google sign-in. Optional: without both values the provider is disabled and
# the "Continue with Google" button is hidden.
# Authorised redirect URI: <PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL for auth email links and the OAuth redirect base.
PUBLIC_SITE_URL=http://localhost:5173

# OpenAI (assessments, content, conversations, orchestrator, reports)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Paymob card + wallet checkout
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=
PAYMOB_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=

# PayPal checkout
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Lemon Squeezy (merchant of record — digital-only + international orders)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Google Calendar (consultation bookings)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Resend (transactional email)
RESEND_API_KEY=

# Google Cloud Storage (document/attachment uploads)
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Books admin import endpoint
BOOKS_ADMIN_SECRET=

# --- Medusa backend (apps/medusa) ---
# Medusa v2 (books commerce backend + admin dashboard). Database and Redis
# are provisioned by deploy/medusa/docker-compose.yml (`pnpm dev:medusa:redis`)
# and the `medusa` database on the shared Postgres container (deploy/db).
# medusa-config.ts wiring happens in a later migration task.
MEDUSA_DATABASE_URL=postgresql://darnozom:darnozom@localhost:5432/medusa
MEDUSA_REDIS_URL=redis://localhost:6381
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=
MEDUSA_ADMIN_CORS=http://localhost:9000
MEDUSA_STORE_CORS=http://localhost:5173

# Better Auth bridge (identity trust boundary between apps/api and
# apps/medusa — set identically in both apps/api/.env and apps/medusa/.env)
BETTER_AUTH_BRIDGE_SECRET=
