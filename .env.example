# Root workspace env — used by `pnpm dev:db` (docker compose) and by the API.
# Copy to `.env` for local development. The client has its own
# apps/client/.env.example for VITE_* variables.

# --- Local Postgres (deploy/db/docker-compose.yml) ---
POSTGRES_DB=darnozom
POSTGRES_USER=darnozom
POSTGRES_PASSWORD=darnozom
# If you already run Postgres natively on 5432, set this to a free port
# (e.g. 5433) and match it in DATABASE_URL below.
POSTGRES_PORT=5432

# --- API server (apps/api) ---
DATABASE_URL=postgresql://darnozom:darnozom@localhost:5432/darnozom
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# --- Optional integrations. Every one of these is optional: the API boots and
# --- serves all unrelated routes without them; only the specific feature fails.
CLERK_SECRET_KEY=
ADMIN_EMAILS=
ADMIN_CLERK_USER_IDS=
PUBLIC_SITE_URL=http://localhost:5173

# OpenAI (assessments, content, conversations, orchestrator, reports)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Paymob card + wallet checkout
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=
PAYMOB_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=

# PayPal checkout
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Google Calendar (consultation bookings)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Resend (transactional email)
RESEND_API_KEY=

# Google Cloud Storage (document/attachment uploads)
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Books admin import endpoint
BOOKS_ADMIN_SECRET=
