{
  "name": "darnozom-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:servers": "pnpm -r --parallel run dev",
    "dev": "pnpm dev:services && pnpm dev:servers",
    "dev:db": "docker compose --project-directory . -f deploy/db/docker-compose.yml up -d",
    "dev:db:down": "docker compose --project-directory . -f deploy/db/docker-compose.yml down",
    "dev:db:logs": "docker compose --project-directory . -f deploy/db/docker-compose.yml logs -f db",
    "dev:client": "pnpm --filter @workspace/client dev",
    "dev:api": "pnpm --filter @workspace/api-server dev",
    "dev:medusa": "pnpm --filter medusa dev",
    "dev:medusa:redis": "docker compose --project-directory . -f deploy/medusa/docker-compose.yml up -d",
    "dev:medusa:redis:down": "docker compose --project-directory . -f deploy/medusa/docker-compose.yml down",
    "db:push": "pnpm --filter @workspace/db push",
    "db:seed:users": "pnpm --filter @workspace/api-server run seed:dev-users",

    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:client": "pnpm --filter @workspace/client build",
    "build:api": "pnpm --filter @workspace/api-server build",
    "build:medusa": "pnpm --filter medusa build",
    "typecheck:packages": "tsc --build",
    "typecheck": "pnpm run typecheck:packages && pnpm -r --filter \"./apps/**\" --if-present run typecheck",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
